# ============================================
# KSA — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ============================================

# Serveur
PORT=3001
NODE_ENV=development

# Base de données PostgreSQL (Render te fournit DATABASE_URL automatiquement)
DATABASE_URL=postgresql://user:password@localhost:5432/ksa_db

# JWT
JWT_SECRET=ksa_secret_key_kingsley_2024_minimum_32_chars
JWT_EXPIRES_IN=7d

# OpenRouter API (gratuit)
OPENROUTER_API_KEY=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

# Upload de fichiers
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# CORS — URLs autorisées (sépare par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,https://kingsley-school-assistant.onrender.com

# Admin par défaut (créé au premier démarrage)
ADMIN_EMAIL=admin@kingsley.edu
ADMIN_PASSWORD=AdminKSA2025!