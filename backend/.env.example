# ============================================
# KSA — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ============================================

# Serveur
PORT=3001
NODE_ENV=development

# Base de données PostgreSQL (Render te fournit DATABASE_URL automatiquement)
DATABASE_URL=postgresql://user:password@localhost:5432/ksa_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Anthropic API (pour la génération de fiches et le chat IA)
ANTHROPIC_API_KEY=sk-ant-...

# Upload de fichiers
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# CORS — URLs autorisées (sépare par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,https://ton-app.onrender.com

# Admin par défaut (créé au premier démarrage)
ADMIN_EMAIL=admin@kingsley.edu
ADMIN_PASSWORD=AdminKSA2025!
